{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "profes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && auth.provider !== 'anonymous' && !data.exists() && newData.child('estado').val() === 'aprobado') || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['nombre', 'correo', 'estado'])",
        "estado": {
          ".write": "auth != null && auth.uid === $uid && auth.provider !== 'anonymous' && data.val() === 'pendiente' && newData.val() === 'aprobado'",
          ".validate": "newData.val() === 'pendiente' || newData.val() === 'aprobado' || newData.val() === 'rechazado'"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "correo": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "mensaje": {
          ".validate": "newData.isString() && newData.val().length <= 600"
        },
        "idioma": {
          ".validate": "newData.val() === 'es' || newData.val() === 'en' || newData.val() === 'pt' || newData.val() === 'varios'"
        },
        "creado": {
          ".validate": "newData.isNumber()"
        },
        "idiomas": {
          ".validate": "newData.hasChildren()",
          "$l": {
            ".validate": "($l === 'es' || $l === 'en' || $l === 'pt') && newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "claves": {
      "$tablero": {
        ".read": "auth != null && auth.provider !== 'anonymous' && (root.child('profes').child(auth.uid).child('estado').val() === 'aprobado' || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isString() && newData.val().length >= 40 && newData.val().length <= 60"
      }
    },
    "salas": {
      "$sala": {
        "dueno": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && (root.child('profes').child(auth.uid).child('estado').val() === 'aprobado' || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "cerrada": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('salas').child($sala).child('dueno').val() === auth.uid && newData.val() === true",
          ".validate": "newData.val() === true"
        },
        "clave": {
          ".read": "auth != null && !root.child('salas').child($sala).child('cerrada').exists()",
          ".write": "auth != null && root.child('salas').child($sala).child('dueno').val() === auth.uid && (!newData.exists() || !root.child('salas').child($sala).child('cerrada').exists())",
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "ajustes": {
          ".read": "auth != null && !root.child('salas').child($sala).child('cerrada').exists()",
          ".write": "auth != null && root.child('salas').child($sala).child('dueno').val() === auth.uid && (!newData.exists() || !root.child('salas').child($sala).child('cerrada').exists())",
          "menuOculto": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "d": {
          ".read": "auth != null && !root.child('salas').child($sala).child('cerrada').exists()",
          ".write": "auth != null && root.child('salas').child($sala).child('dueno').val() === auth.uid && (!newData.exists() || !root.child('salas').child($sala).child('cerrada').exists())",
          "$doc": {
            ".validate": "newData.hasChildren(['j', 't'])",
            "j": {
              ".validate": "newData.isString() && newData.val().length <= 65536"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "pres": {
          ".read": "auth != null && !root.child('salas').child($sala).child('cerrada').exists()",
          ".write": "auth != null && root.child('salas').child($sala).child('dueno').val() === auth.uid && !newData.exists()",
          "$p": {
            ".write": "auth != null && root.child('salas').child($sala).child('dueno').exists() && (!newData.exists() || !root.child('salas').child($sala).child('cerrada').exists()) && (auth.uid === $p || ($p === 'P' && root.child('salas').child($sala).child('dueno').val() === auth.uid))",
            ".validate": "newData.hasChildren(['j', 't'])",
            "j": {
              ".validate": "newData.isString() && newData.val().length <= 4096"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ev": {
          ".read": "auth != null && !root.child('salas').child($sala).child('cerrada').exists()",
          ".write": "auth != null && root.child('salas').child($sala).child('dueno').val() === auth.uid && !newData.exists()",
          "$u": {
            ".write": "auth != null && root.child('salas').child($sala).child('dueno').exists() && (!newData.exists() || !root.child('salas').child($sala).child('cerrada').exists()) && auth.uid === $u",
            ".validate": "newData.hasChildren(['n', 'de', 'k', 't'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "de": {
              ".validate": "newData.isString() && (newData.val() === auth.uid || (newData.val() === 'P' && root.child('salas').child($sala).child('dueno').val() === auth.uid)) && newData.val().length <= 128"
            },
            "k": {
              ".validate": "newData.isNumber()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "d": {
              ".validate": "!newData.isString() || newData.val().length <= 4096"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tareas": {
      "$c": {
        ".read": "auth != null && data.child('dueno').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('dueno').val() === auth.uid && auth.provider !== 'anonymous' && (root.child('profes').child(auth.uid).child('estado').val() === 'aprobado' || root.child('admins').child(auth.uid).val() === true)) || (!newData.exists() && data.child('dueno').val() === auth.uid))",
        ".validate": "$c.matches(/^[0-9a-z]{10}$/) && newData.hasChildren(['dueno', 'tablero', 'creada'])",
        "dueno": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "tablero": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "creada": {
          ".validate": "newData.val() === now"
        },
        "etiqueta": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "archivada": {
          ".write": "auth != null && root.child('tareas').child($c).child('dueno').val() === auth.uid",
          ".validate": "newData.val() === true"
        },
        "entregas": {
          "$u": {
            ".write": "auth != null && ((newData.exists() && auth.uid === $u && root.child('tareas').child($c).child('dueno').exists()) || (!newData.exists() && root.child('tareas').child($c).child('dueno').val() === auth.uid))",
            ".validate": "newData.hasChildren(['nombre', 'fecha', 'puntaje', 'lengua'])",
            "nombre": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "fecha": {
              ".validate": "newData.val() === now"
            },
            "puntaje": {
              ".validate": "newData.hasChildren(['aciertos', 'total']) && newData.child('aciertos').val() <= newData.child('total').val()",
              "aciertos": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "total": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "$other": {
                ".validate": false
              }
            },
            "ejercicios": {
              "$i": {
                ".validate": "$i.matches(/^([0-9]|1[01])$/) && newData.hasChildren(['tipo', 'aciertos', 'total'])",
                "tipo": {
                  ".validate": "newData.isString() && newData.val().length <= 20"
                },
                "aciertos": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
                },
                "total": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "errores": {
              "$i": {
                ".validate": "$i.matches(/^([0-9]|[12][0-9])$/) && newData.hasChildren(['escrito', 'correcto'])",
                "p": {
                  ".validate": "newData.isString() && newData.val().length <= 300"
                },
                "escrito": {
                  ".validate": "newData.isString() && newData.val().length <= 300"
                },
                "correcto": {
                  ".validate": "newData.isString() && newData.val().length <= 300"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "reto": {
              ".validate": "newData.isString() && newData.val().length <= 3000"
            },
            "lengua": {
              ".validate": "newData.val() === 'es' || newData.val() === 'en' || newData.val() === 'pt'"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tareasPorProfe": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.provider !== 'anonymous'",
        "$c": {
          ".validate": "newData.val() === true && $c.matches(/^[0-9a-z]{10}$/)"
        }
      }
    }
  }
}
