{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "profes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && auth.provider !== 'anonymous' && !data.exists() && newData.child('estado').val() === 'pendiente') || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['nombre', 'correo', 'estado'])",
        "estado": {
          ".validate": "newData.val() === 'pendiente' || newData.val() === 'aprobado' || newData.val() === 'rechazado'"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "correo": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "mensaje": {
          ".validate": "newData.isString() && newData.val().length <= 600"
        },
        "idioma": {
          ".validate": "newData.val() === 'es' || newData.val() === 'en' || newData.val() === 'pt' || newData.val() === 'varios'"
        },
        "creado": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "claves": {
      "$tablero": {
        ".read": "auth != null && auth.provider !== 'anonymous' && (root.child('profes').child(auth.uid).child('estado').val() === 'aprobado' || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isString() && newData.val().length >= 40 && newData.val().length <= 60"
      }
    },
    "salas": {
      "$sala": {
        ".read": "auth != null",
        "dueno": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && (root.child('profes').child(auth.uid).child('estado').val() === 'aprobado' || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "clave": {
          ".write": "auth != null && root.child('salas').child($sala).child('dueno').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "d": {
          ".write": "auth != null && root.child('salas').child($sala).child('dueno').val() === auth.uid",
          "$doc": {
            ".validate": "newData.hasChildren(['j', 't'])",
            "j": {
              ".validate": "newData.isString() && newData.val().length <= 65536"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "pres": {
          "$p": {
            ".write": "auth != null && root.child('salas').child($sala).child('dueno').exists() && (auth.uid === $p || ($p === 'P' && root.child('salas').child($sala).child('dueno').val() === auth.uid))",
            ".validate": "newData.hasChildren(['j', 't'])",
            "j": {
              ".validate": "newData.isString() && newData.val().length <= 4096"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ev": {
          "$u": {
            ".write": "auth != null && root.child('salas').child($sala).child('dueno').exists() && auth.uid === $u",
            ".validate": "newData.hasChildren(['n', 'de', 'k', 't'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "de": {
              ".validate": "newData.isString() && (newData.val() === auth.uid || (newData.val() === 'P' && root.child('salas').child($sala).child('dueno').val() === auth.uid)) && newData.val().length <= 128"
            },
            "k": {
              ".validate": "newData.isNumber()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "d": {
              ".validate": "!newData.isString() || newData.val().length <= 4096"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
